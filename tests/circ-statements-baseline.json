    "2.7": {
      "file": "content/circ/ch02-b.js",
      "hash": "923cceece8368c3e500cf0b64328983e120e581b2e134e87c9188dbd382d9822",
      "fields": {
        "statement": {
          "before": "A connected circuit with $n$ nodes and $b$ branches has exactly $n-1$ independent KCL equations (the equations at all $n$ nodes sum to zero, so any one is redundant) and exactly $b-n+1$ independent KVL equations (one per fundamental loop of any spanning tree). Together they give $b$ equations for the $b$ branch variables of each kind; adding the $b$ element laws, the $2b$ branch currents and voltages are determined. For a graph with $c$ connected components the counts become $n-c$ and $b-n+c$.",
          "after": "A connected circuit with $n$ nodes and $b$ branches has exactly $n-1$ independent KCL equations (the equations at all $n$ nodes sum to zero, so any one is redundant) and exactly $b-n+1$ independent KVL equations (one per fundamental loop of any spanning tree). Together these give $b$ independent topological constraints on the $2b$ branch currents and voltages. Adding $b$ element laws gives $2b$ equations, but consistency and uniqueness require a well-posed constitutive problem; the equation count alone does not guarantee them. For a graph with $c$ connected components the counts become $n-c$ and $b-n+c$.",
          "expectedHash": "195b88b45d9bd9dbe9f2d35c8f186ddbbb3986ee14befb5c0db8a441ec974da1"
        }
      }
    },
